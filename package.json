{
  "name": "camerlob",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Local-first, unlimited, free image format converter.",
  "homepage": "https://github.com/camerlob/camerlob#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/camerlob/camerlob.git"
  },
  "bugs": {
    "url": "https://github.com/camerlob/camerlob/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "check-engines": "tsx scripts/check-engines.ts",
    "backend:audit": "tsx scripts/audit-matrix.ts; tsx scripts/check-engines.ts; pnpm list sharp jszip file-saver heic2any browser-image-compression",
    "seed-test-files": "tsx scripts/seed-test-files.ts",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "browser-image-compression": "2.0.2",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "file-saver": "2.0.5",
    "framer-motion": "11.3.24",
    "heic2any": "0.0.4",
    "jszip": "3.10.1",
    "lucide-react": "0.427.0",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-dropzone": "14.2.3",
    "sharp": "0.33.4",
    "sonner": "1.5.0",
    "tailwind-merge": "2.5.2",
    "zod": "3.23.8",
    "zustand": "4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "19.4.0",
    "@commitlint/config-conventional": "19.4.1",
    "@playwright/test": "1.46.0",
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "16.0.0",
    "@types/file-saver": "2.0.7",
    "@types/node": "20.14.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "@vitest/coverage-v8": "1.6.0",
    "autoprefixer": "10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "husky": "9.1.4",
    "jsdom": "24.1.1",
    "lint-staged": "15.2.8",
    "postcss": "8.4.40",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.6",
    "tailwindcss": "3.4.7",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.17.0",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  }
}
