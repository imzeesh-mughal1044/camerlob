# ---- Client-visible (inlined at build time; must be safe to expose) ----
# v1 declares no NEXT_PUBLIC_* variables. The product name and canonical URL are
# literals in lib/constants/site.ts and app/layout.tsx, and the batch,
# concurrency and timeout limits are exported constants in
# lib/constants/limits.ts. See Documents/TRD.md 14.2 and
# Documents/FOLDER-ARCHITECTURE.md 11.

# ---- Server-only (never prefixed NEXT_PUBLIC_) ----
# Per-file server ceiling, in megabytes. Unset falls back to
# SERVER_MAX_FILE_SIZE_MB in lib/constants/limits.ts.
SERVER_MAX_FILE_SIZE_MB=50

# Absolute paths to the native engines. Leave blank to resolve each binary from
# PATH; blank means "not configured", not "empty path".
IMAGEMAGICK_PATH=/usr/bin/magick
LIBRAW_PATH=/usr/bin/dcraw_emu
GHOSTSCRIPT_PATH=/usr/bin/gs
EXIFTOOL_PATH=/usr/bin/exiftool

# Scratch directory for conversion jobs. Must be outside the repository.
TEMP_UPLOAD_DIR=/tmp/camerlob

# Managed by Next.js; declared so the detection script and self-hosters see it.
NODE_ENV=development

# ---- CLI only ----
# Honoured by scripts/check-engines.ts. A shell convention rather than
# application configuration, so set it in your shell rather than in .env.local.
# NO_COLOR=1
